# saasy-orchestrator environment
# Copy to .env for local development. config/default.toml provides defaults
# for the non-secret values. All provider API keys are required at startup,
# even for providers you don't select in a session.

HTTP_HOST=0.0.0.0
HTTP_PORT=8081

# Control plane (saasy-signal)
SIGNAL_HTTP_URL=http://127.0.0.1:3000
SIGNAL_SYSTEM_WS_URL=ws://127.0.0.1:3000/ws/system
SIGNAL_SESSION_WS_URL=ws://127.0.0.1:3000/ws/session

# Provider model catalog (saasy-edge)
EDGE_GRPC_URL=http://127.0.0.1:9090

# Media engines (gRPC over Unix Domain Sockets)
LISTENING_ENGINE_GRPC_UDS=/tmp/listening-engine.sock
SPEAKING_ENGINE_GRPC_UDS=/tmp/speaking-engine.sock

# Provider API keys (all required at startup)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# GCP (Vertex). Two options:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  (local dev)
#   GCP_SA_JSON='{...json...}'  (containers; run-with-gcp.sh writes it to a
#   temp file and sets GOOGLE_APPLICATION_CREDENTIALS)
GCP_PROJECT_ID=
GCP_REGION=global
# GOOGLE_APPLICATION_CREDENTIALS=
# GCP_SA_JSON=

# AWS (Bedrock)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RUST_LOG=info
